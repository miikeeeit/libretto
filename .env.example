# Copia questo file in `.env` e riempilo con i valori del tuo progetto Firebase.
# Console Firebase → Impostazioni progetto → Le tue app → Configurazione SDK.
# `.env` non entra in git (vedi .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "1" = si lavora sugli emulatori locali: nessun SMS parte davvero e non si spende niente.
# Da tenere a 1 finché l'avviso di budget su Blaze non è impostato (decisione PC1).
VITE_USA_EMULATORI=1
