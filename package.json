{
  "name": "libretto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "firebase emulators:exec --only firestore --project libretto-prova \"node --test test/*.test.mjs\"",
    "emulatori": "npm --prefix functions run build && firebase emulators:start",
    "deploy:regole": "firebase deploy --only firestore:rules,storage",
    "deploy": "npm run build && firebase deploy --only hosting,firestore,storage,functions",
    "prova:flusso": "node strumenti/prova-flusso.mjs",
    "deploy:funzioni": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^14.27.0",
    "playwright": "^1.56.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
